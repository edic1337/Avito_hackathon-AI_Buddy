# Copy to .env for local use. Never commit real secrets.

# Go chat backend
OPENROUTER_API_KEY=
API_URL=
OPENROUTER_API_URL=
OPENROUTER_MODEL=

# Local PostgreSQL / pgvector
RAG_DB_PORT=65432
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:65432/avito_buddy?sslmode=disable
RAG_COLLECTION=avito-habr

# OpenAI-compatible embedding endpoint used by the Go backend
EMBEDDING_API_URL=http://localhost:8081/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_REVISION=
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT=60s

# RAG corpus preparation
EMBEDDING_DEVICE=cpu
# Optional: defaults to EMBEDDING_MODEL. Use the matching tokenizer.
# TOKENIZER_MODEL=Qwen/Qwen3-Embedding-0.6B
CHUNK_TARGET_TOKENS=300
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=40
RAG_CHUNKING_CONFIG='{"tokenizer_model":"Qwen/Qwen3-Embedding-0.6B","target_tokens":300,"max_tokens":400,"overlap_tokens":40}'

# Retrieval and generation
TOP_K=6
RAG_CANDIDATE_LIMIT=30
MIN_SIMILARITY=0.45
RAG_MAX_CONTEXT_RUNES=12000
CONTEXT_TOKEN_BUDGET=3000
USE_RERANKER=false
USE_QUERY_REWRITE=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_MOCK=false
