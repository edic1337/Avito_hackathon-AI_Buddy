OPENROUTER_API_KEY=
API_URL=
OPENROUTER_API_URL=
OPENROUTER_MODEL=

# Go RAG: PostgreSQL with pgvector. Never expose this demo password publicly.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/avito_buddy
RAG_COLLECTION=main
# Full OpenAI-compatible embedding endpoint, not the chat endpoint.
EMBEDDING_API_URL=http://localhost:8081/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Empty means unknown revision, compatible with the existing RAG export.
EMBEDDING_REVISION=
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT=60s
TOP_K=6
RAG_CANDIDATE_LIMIT=30
MIN_SIMILARITY=0.45
RAG_MAX_CONTEXT_RUNES=12000
# Must match the upstream preparation profile. Changing it requires a new collection.
RAG_CHUNKING_CONFIG='{"tokenizer_model":"Qwen/Qwen3-Embedding-0.6B","target_tokens":300,"max_tokens":400,"overlap_tokens":40}'
