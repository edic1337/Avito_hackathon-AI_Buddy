# Copy this file to .env. The real .env is intentionally ignored by Git.
# Process environment variables override this file; CLI --device overrides device.

# Portable local inference. Use cuda on a machine with CUDA-enabled PyTorch.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
# Optional: defaults to EMBEDDING_MODEL. Use the matching tokenizer.
# TOKENIZER_MODEL=Qwen/Qwen3-Embedding-0.6B

CHUNK_TARGET_TOKENS=300
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=40

# Reserved for the PostgreSQL repository (not implemented yet).
# Replace the example credentials with your own before connecting to a DB.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/avito_buddy

# Reserved for retrieval and generation (interfaces exist, implementations pending).
TOP_K=6
MIN_SIMILARITY=0.45
CONTEXT_TOKEN_BUDGET=3000
USE_RERANKER=false
USE_QUERY_REWRITE=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_MOCK=false
